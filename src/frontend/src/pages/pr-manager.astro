---
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
export const prerender = false;

let jobs: any[] = [];
let error: string | null = null;

import { getAgentByName } from "agents";

try {
  const env = Astro.locals.runtime?.env;
  if (env && env.PR_MANAGER_AGENT) {
    const agent = await getAgentByName(env.PR_MANAGER_AGENT as any, 'singleton');
    const response = await agent.fetch(new Request('http://do/api/jobs'));
    if (response.ok) {
      jobs = await response.json();
    } else {
      error = "Failed to fetch jobs from PR Manager Agent: " + response.status;
    }
  } else {
    error = "PR_MANAGER_AGENT binding not found. Are you running in Wrangler?";
  }
} catch (e: any) {
  error = e.message;
}
---

<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <title>PR Manager Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      background-color: #09090b;
      color: #fafafa;
      font-family: system-ui, -apple-system, sans-serif;
      padding: 2rem;
    }
  </style>
</head>
<body class="bg-background text-foreground min-h-screen">
  <div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8">PR Manager Agent Jobs</h1>

    {error && (
      <div class="bg-destructive/10 border border-destructive text-destructive-foreground p-4 rounded mb-6">
        {error}
      </div>
    )}

    {jobs.length === 0 && !error && (
      <p class="text-muted-foreground text-center py-8">No PR jobs found.</p>
    )}

    <div class="grid gap-4">
      {jobs.map((job) => (
        <Card className="hover:bg-accent/10 transition-colors">
          <CardHeader>
            <CardTitle className="text-xl">
              <a href={`https://github.com/${job.owner}/${job.repo}/pull/${job.pull_number}`} target="_blank" rel="noopener noreferrer" class="hover:underline">
                {job.owner}/{job.repo} #{job.pull_number}
              </a>
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-sm gap-2">
              <div class="flex items-center gap-2">
                <span class="text-muted-foreground">Status:</span>
                <span class={`px-2 py-1 rounded text-xs font-semibold ${
                  job.status === 'conflict_resolved' ? 'bg-green-500/20 text-green-400' :
                  job.status === 'conflict_commented' ? 'bg-yellow-500/20 text-yellow-400' :
                  'bg-red-500/20 text-red-400'
                }`}>
                  {job.status}
                </span>
              </div>
              <span class="text-muted-foreground">{new Date(job.created_at).toLocaleString()}</span>
            </div>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</body>
</html>
