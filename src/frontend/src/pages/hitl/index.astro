---
import '@/index.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HitlDashboard } from '@/components/hitl/HitlDashboard';
---

<BaseLayout title="HITL Dashboard" description="Human-in-the-Loop Operations Overview">
  <div class="h-full w-full flex flex-col p-6 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white mb-2">HITL Operations</h1>
        <p class="text-muted-foreground">Approve, reject, or re-run automated background actions</p>
      </div>
    </div>
    <div class="flex-1 w-full relative">
        <HitlDashboard client:load />
    </div>
  </div>
</BaseLayout>
