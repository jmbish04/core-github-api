---
import '@/index.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BuildAnalysisCategory } from '@/components/hitl/categories/BuildAnalysisCategory';
---

<BaseLayout title="Build Analysis Queue" description="HITL CI Healer Build Analysis Queue">
  <div class="h-full w-full flex flex-col p-6 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white mb-2">Build Analysis Queue</h1>
        <p class="text-muted-foreground">Review CI Healer logic, tweak repair strategy, and dispatch auto-fix</p>
      </div>
      <div>
         <a href="/hitl" class="text-sm font-medium text-blue-500 hover:text-blue-400">&larr; Back to Dashboard</a>
      </div>
    </div>
    
    <div class="flex-1 w-full max-w-4xl pt-4">
        <BuildAnalysisCategory client:load />
    </div>
  </div>
</BaseLayout>
