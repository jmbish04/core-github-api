<!-- Roadmap Section -->
<section id="roadmap" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 fade-in-up">
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-4">{{roadmap.title}}</h2>
            <div class="w-24 h-1 bg-gradient-to-r from-indigo-600 to-purple-600 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
            {{#each roadmap.milestones}}
            <div class="fade-in-up relative">
                {{#unless @last}}
                <div class="hidden md:block absolute top-16 left-1/2 w-full h-0.5 
                        {{#if (eq this.status 'completed')}}bg-emerald-200{{/if}}
                        {{#if (eq this.status 'in-progress')}}bg-indigo-200{{/if}}
                        {{#if (eq this.status 'planned')}}bg-slate-200{{/if}}">
                </div>
                {{/unless}}

                <div class="relative z-10 text-center">
                    <div class="inline-block px-6 py-3 text-white rounded-full font-bold text-lg mb-4
                            {{#if (eq this.status 'completed')}}bg-emerald-600{{/if}}
                            {{#if (eq this.status 'in-progress')}}bg-indigo-600{{/if}}
                            {{#if (eq this.status 'planned')}}bg-slate-600{{/if}}">
                        {{this.version}}
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">{{this.title}}</h3>
                    <div class="bg-white p-6 rounded-xl shadow-lg border 
                            {{#if (eq this.status 'completed')}}border-emerald-100{{/if}}
                            {{#if (eq this.status 'in-progress')}}border-indigo-100{{/if}}
                            {{#if (eq this.status 'planned')}}border-slate-100{{/if}}">
                        <ul class="space-y-2 text-left">
                            {{#each this.items}}
                            <li class="flex items-start space-x-2">
                                <span class="mt-1
                                        {{#if (eq ../status 'completed')}}text-emerald-600{{/if}}
                                        {{#if (eq ../status 'in-progress')}}text-indigo-600{{/if}}
                                        {{#if (eq ../status 'planned')}}text-slate-600{{/if}}">•</span>
                                <span class="text-slate-700">{{this}}</span>
                            </li>
                            {{/each}}
                        </ul>
                    </div>
                    <div class="mt-4">
                        <span class="px-4 py-2 rounded-full text-sm font-semibold uppercase
                                {{#if (eq this.status 'completed')}}bg-emerald-100 text-emerald-700{{/if}}
                                {{#if (eq this.status 'in-progress')}}bg-indigo-100 text-indigo-700{{/if}}
                                {{#if (eq this.status 'planned')}}bg-slate-100 text-slate-700{{/if}}">
                            {{this.status}}
                        </span>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>