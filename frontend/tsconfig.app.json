{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "types": [
      "vite/client",
      "astro/client"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@diceui/timeline": [
        "./src/components/ui/diceui/timeline.tsx"
      ],
      "@diceui/kanban": [
        "./src/components/ui/diceui/kanban.tsx"
      ],
      "@diceui/stat": [
        "./src/components/ui/diceui/stat.tsx"
      ]
    }
  },
  "include": [
    "src",
    "src/**/*.astro"
  ]
}
