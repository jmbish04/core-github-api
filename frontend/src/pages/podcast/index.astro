---
import RootLayout from '../../layouts/RootLayout';
import { PodcastStudio } from '../../components/podcast/PodcastStudio';

// For static Astro generation we cannot use React Router's BrowserRouter directly
// in the SSR pass easily if the layout uses useLocation.
// Since this app uses React Router, usually there's a main entry point.
// Let's just create a simple client-only wrapper.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Podcast Studio</title>
</head>
<body>
  <div id="root"></div>
  <script>
    // Just a placeholder since the actual React app takes over routing via App.tsx
    window.location.replace("/#podcast"); // Redirect to React Router if hash routing, or handled by Vite fallback
  </script>
</body>
</html>
