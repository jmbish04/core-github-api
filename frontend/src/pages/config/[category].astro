---
import { ConfigDashboard } from "@/components/config/ConfigDashboard";

export function getStaticPaths() {
  return [
    { params: { category: "general" } },
    { params: { category: "ai" } },
    { params: { category: "github" } },
    { params: { category: "secrets" } },
    { params: { category: "skills" } },
  ];
}

const { category } = Astro.params;
---

<ConfigDashboard client:only="react" category={category} />
