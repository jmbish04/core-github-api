{
  "name": "core-github-api",
  "main": "src/backend/src/index.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "workers_dev": true,
  "dev": {
    "port": 8787
  },
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "LOG_LEVEL": "debug",
    "AI_DEFAULT_PROVIDER": "worker-ai",
    "AI_DEFAULT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_MODEL": "gemini-3-pro-preview",
    "OPENAI_MODEL": "gpt-5.1",
    "DEFAULT_MODEL_REASONING": "@cf/openai/gpt-oss-120b",
    "DEFAULT_MODEL_STRUCTURED_RESPONSE": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "DEFAULT_MODEL_EMBEDDING": "@cf/baai/bge-large-en-v1.5",
    "DEFAULT_MODEL_RERANKER": "@cf/baai/bge-reranker-base",
    "HEALTH_SANDBOX_TIMEOUT_MS": 60000,
    "AI_GATEWAY_NAME": "core-github-api",
    "CLOUDFLARE_WORKER_NAME": "core-github-api",
    "GITHUB_OWNER": "jmbish04",
    "TEMPLATES_REPO_NAME": "core-repo-templates",
    "STANDARDIZATION_REPO_NAME": "core-github-standardization",
    "HEALTH_TEST_REPO_NAME": "testing-oktokit-commands",
    "RESEARCH_QUEUE_REPO_NAME": "core-github-research",
    "RESEARCH_QUEUE_REPO_DISPATCHER_URI": "https://api.github.com/repos/jmbish04/core-github-research/dispatches",
    "BASE_URL": "https://core-github-api.hacolby.workers.dev",
    "WEBHOOK_URL": "https://core-github-api.hacolby.workers.dev/api/webhooks",
    "MAX_AI_BUDGET": "50",
    "USE_OPENAI_MODELS": false,
    "GITHUB_REPO_STANDARDIZATION": "jmbish04/core-github-standardization",
    "GITHUB_ACTION_WORKER_DISPATCHER_URI": "https://api.github.com/repos/jmbish04/core-github-standardization/dispatches",
    "MCP_API_URL": "https://docs.mcp.cloudflare.com/mcp",
    "EDGRAPH_URL": "https://core-github-api-edgraph.hacolby.workers.dev",
    "SANDBOX_SLEEP_AFTER": "30s",
    "SANDBOX_INSTANCE_GET_TIMEOUT_MS": 180000,
    "SANDBOX_PORT_READY_TIMEOUT_MS": 180000,
    "SANDBOX_EXPOSED_HTTP_PORT": 8080
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./container/Dockerfile",
      "max_instances": 5,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 4096,
        "disk_mb": 6144
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.hbs",
        "**/*.md",
        "**/*.yml",
        "**/*.yaml"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/openapi.json",
      "/swagger",
      "/scalar",
      "/health",
      "/context",
      "/docs",
      "/mcp",
      "/mcp/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_CLIENT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CORE_GITHUB_API_GITHUB_CLIENT_ID"
    },
    {
      "binding": "GITHUB_CLIENT_SECRET",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CORE_GITHUB_API_GITHUB_SECRET"
    },
    {
      "binding": "GITHUB_APP_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CORE_GITHUB_API_GITHUB_APP_ID"
    },
    {
      "binding": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT1",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT1"
    },
    {
      "binding": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT2",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT2"
    },
    {
      "binding": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT3",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT3"
    },
    {
      "binding": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_API_TOKEN"
    },
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "OPENAI_API_KEY"
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID"
    },
    {
      "binding": "CLOUDFLARE_SECRETS_STORE_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_SECRETS_STORE_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_WORKER_ADMIN_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WORKER_ADMIN_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_AI_SEARCH_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_SEARCH_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_OBSERVABILITY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_OBSERVABILITY_TOKEN"
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY"
    },
    {
      "binding": "AGENTIC_WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "AGENTIC_WORKER_API_KEY"
    },
    {
      "binding": "AI_GATEWAY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN"
    },
    {
      "binding": "CF_BROWSER_RENDER_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_BROWSER_RENDER_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_IMAGES_STREAM_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_IMAGES_STREAM_TOKEN"
    },
    {
      "binding": "STITCH_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "STITCH_API_KEY"
    },
    {
      "binding": "JULES_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "JULES_API_KEY"
    },
    {
      "binding": "GEMINI_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_API_KEY"
    },
    {
      "binding": "ANTHROPIC_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "ANTHROPIC_API_KEY"
    },
    {
      "binding": "DISCORD_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "DISCORD_TOKEN"
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1"
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2"
    }
  ],
  "durable_objects": {
