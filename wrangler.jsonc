  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrchestratorAgent",
        "RetrofitAgent",
        "RoomDO",
        "GeminiAgent",
        "PlannerAgent",
        "RepoAgent",
        "Supervisor",
        "DeepReasoningAgent",
        "Sandbox",
        "OwnerAgent",
        "ResearchAgent",
        "DiscordResearchAgent",
        "JulesOverseer",
        "TopicOrchestratorAgent",
        "WebSearchAgent",
        "JudgeAgent",
        "ReportingAgent",
        "LandingPageAgent",
        "CloudflareDocsAgent",
        "DeepResearchChatAgent",
        "HealthDiagnostician",
        "JulesWebhookBroadcaster",
        "PlanningMonitor",
        "ReverseEngineeringMonitor",
        "PlanningSupervisorAgent",
        "PlanningOrchestratorAgent",
        "HoniOrchestrator",
        "HoniConsultant",
        "WorkshopAgent",
        "CfWorkshop_AgentsSdk",
        "StandardizationAgent",
        "JulesPrReviewer",
        "UxResearcher",
        "AgentSessionDO",
        "SandboxAgent"
      ]
    },
    {
      "tag": "v1_sentinel",
      "new_sqlite_classes": [
        "PRSupervisorDO",
        "PRReviewDO",
        "PRSummaryDO",
        "LearningAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PrManagerAgent"
      ]
    }
  ],
  "workflows": [
    {
      "name": "GithubSearchWorkflow",
      "binding": "GITHUB_SEARCH_WORKFLOW",
      "class_name": "GithubSearchWorkflow"
    },
    {
      "name": "deep-research-workflow",
      "binding": "DEEP_RESEARCH_WORKFLOW",
      "class_name": "DeepResearchWorkflow"
    },
    {
      "name": "research-orchestrator",
      "binding": "RESEARCH_ORCHESTRATOR",
      "class_name": "ResearchOrchestrator"
    },
    {
      "name": "LearningWorkflow",
      "binding": "LEARNING_WORKFLOW",
      "class_name": "LearningWorkflow",
      "script_name": "core-github-api"
    },
    {
      "name": "topic-research-workflow",
      "binding": "TOPIC_RESEARCH_WORKFLOW",
      "class_name": "TopicResearchWorkflow"
    },
    {
      "name": "discord-research-workflow",
      "binding": "DISCORD_RESEARCH_WORKFLOW",
      "class_name": "DiscordResearchWorkflow"
    },
    {
      "name": "planning-orchestrator",
      "binding": "PLANNING_ORCHESTRATOR",
      "class_name": "PlanningOrchestrator"
    },
    {
      "name": "cloudflare-changelog-workflow",
      "binding": "CLOUDFLARE_CHANGELOG_WORKFLOW",
      "class_name": "CloudflareChangelogWorkflow"
    },
    {
      "name": "stitch-loop-workflow",
      "binding": "STITCH_LOOP_WORKFLOW",
      "class_name": "StitchLoopWorkflow"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "PLAN_ARTIFACTS",
      "bucket_name": "core-github-api-plan-artifacts"
    },
    {
      "binding": "ARTIFACT_STORE",
      "bucket_name": "core-planning-artifacts"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ETAG_KV",
      "id": "eed6ba4656704616acf168be80ba770a",
      "preview_id": "cfc441ebd1d8492497f49e88ae98aa2f"
    },
    {
      "binding": "COMMENTS_KV",
      "id": "82d47893d39a4b0fb574b1a760e06452"
    },
    {
      "binding": "AGENT_CACHE",
      "id": "9f070471888c435297b4bce51924f2df"
    },
    {
      "binding": "KV_CONFIGS",
      "id": "a2f723e74e3c4fd6a6377ab09bce9829",
      "remote": true
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "core-github-api-vectors",
      "remote": true
    },
    {
      "binding": "RESEARCH_INDEX",
      "index_name": "core-github-api-research",
      "remote": true
    },
    {
      "binding": "VECTORIZE_LOGS",
      "index_name": "core-github-api-logs",
      "remote": true
    },
    {
      "binding": "PLAN_EMBEDDINGS",
      "index_name": "core-github-api-plan-rag",
      "remote": true
    },
    {
      "binding": "FILE_EMBEDDINGS",
      "index_name": "core-github-api-file-embeddings",
      "remote": true
    },
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "sentinel-patterns"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "core-github-api",
      "database_id": "4db39958-8554-4da4-b23d-8a4ea8404588",
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "DB_WEBHOOKS",
      "database_name": "core-github-api-webhooks",
      "database_id": "df714884-593d-45da-9c7f-9f67903c4fca",
      "migrations_dir": "migrations/webhooks"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    },
    {
      "name": "SEND_EMAIL_NEWSLETTER",
      "destination_address": "ai@126colby.com"
    },
    {
      "name": "Core Github API",
      "allowed_destination_addresses": [
        "ai@126colby.com"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * *",
      "0 2 * * 1",
      "0 */3 * * *",
      "0 3 * * 7",
      "0 */6 * * *",
      "0 6 * * *",
      "*/15 * * * *"
    ]
  },
  "services": [
    {
      "name": "core-github-api-edgraph",
      "binding": "EDGRAPH",
      "service": "core-github-api-edgraph"
    },
    {
      "binding": "CLAUDE_AGENT",
      "service": "claude-agent-worker",
      "entrypoint": "ClaudeAgentRPC"
    }
  ]
}