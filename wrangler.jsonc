{
	"name": "core-github-api",
	"main": "src/backend/src/index.ts",
	"compatibility_date": "2026-04-12",
	"compatibility_flags": [
		"nodejs_compat",
		"no_handle_cross_request_promise_resolution"
	],
	"alias": {
		"zod/v4": "zod",
		"zod/v3": "zod",
		"zod/v4-mini": "zod"
	},
	// "minify": true,
	"workers_dev": true,
	"dev": {
		"port": 8787
	},
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"LOG_LEVEL": "debug",
		"AI_DEFAULT_PROVIDER": "worker-ai",
		"AI_DEFAULT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"GEMINI_MODEL": "gemini-3-pro-preview",
		"OPENAI_MODEL": "gpt-5.1",
		"DEFAULT_MODEL_REASONING": "@cf/openai/gpt-oss-120b",
		"DEFAULT_MODEL_STRUCTURED_RESPONSE": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"DEFAULT_MODEL_EMBEDDING": "@cf/baai/bge-large-en-v1.5",
		"DEFAULT_MODEL_RERANKER": "@cf/baai/bge-reranker-base",
		"HEALTH_SANDBOX_TIMEOUT_MS": 60000,
		"AI_GATEWAY_NAME": "core-github-api",
		"CLOUDFLARE_WORKER_NAME": "core-github-api",
		"GITHUB_OWNER": "jmbish04",
		"TEMPLATES_REPO_NAME": "core-repo-templates",
		"STANDARDIZATION_REPO_NAME": "core-github-standardization",
		"HEALTH_TEST_REPO_NAME": "testing-oktokit-commands",
		"RESEARCH_QUEUE_REPO_NAME": "core-github-research",
		"RESEARCH_QUEUE_REPO_DISPATCHER_URI": "https://api.github.com/repos/jmbish04/core-github-research/dispatches",
		"BASE_URL": "https://core-github-api.hacolby.workers.dev",
		"WEBHOOK_URL": "https://core-github-api.hacolby.workers.dev/api/webhooks",
		"MAX_AI_BUDGET": "50",
		"USE_OPENAI_MODELS": false,
		"GITHUB_REPO_STANDARDIZATION": "jmbish04/core-github-standardization",
		"GITHUB_ACTION_WORKER_DISPATCHER_URI": "https://api.github.com/repos/jmbish04/core-github-standardization/dispatches",
		"MCP_API_URL": "https://docs.mcp.cloudflare.com/mcp",
		"EDGRAPH_URL": "https://core-github-api-edgraph.hacolby.workers.dev",
		"SANDBOX_SLEEP_AFTER": "30s",
		"SANDBOX_INSTANCE_GET_TIMEOUT_MS": 180000, // 3 minutes for provisioning
		"SANDBOX_PORT_READY_TIMEOUT_MS": 180000, // 3 minutes for startup work
		"SANDBOX_EXPOSED_HTTP_PORT": 8080,
		"SANDBOX_CONTROL_PORT": 8788
	},
	"containers": [
		{ "class_name": "Sandbox", "image": "./container/Dockerfile", "max_instances": 5, "instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 6144 } }
	],
	"ai": {
		"binding": "AI"
	},
	// Configures 'wrangler' to treat .hbs files as Text modules (ES importable strings)
	// This allows `import template from "./file.hbs"` to work natively in Workers.
	"rules": [
		{ "type": "Text", "globs": [ "**/*.hbs", "**/*.md", "**/*.yml", "**/*.yaml" ], "fallthrough": true }
	],
	"assets": {
		"directory": "./public/client",
		"binding": "ASSETS",
		// All requests go through the Worker first because:
		// 1. Astro SSR pages need server-side rendering (no static index.html)
		// 2. Hono handles /api/* routes directly
		// 3. The notFound handler falls back to c.env.ASSETS.fetch() for static files
		"run_worker_first": true,
		"not_found_handling": "none"
	},
	"secrets_store_secrets": [
		{ "binding": "GITHUB_CLIENT_ID", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CORE_GITHUB_API_GITHUB_CLIENT_ID" },
		{ "binding": "GITHUB_CLIENT_SECRET", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CORE_GITHUB_API_GITHUB_SECRET" },
		{ "binding": "GITHUB_APP_ID", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CORE_GITHUB_API_GITHUB_APP_ID" },
		{ "binding": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT1", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT1" },
		{ "binding": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT2", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT2" },
		{ "binding": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT3", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CORE_GITHUB_API_GITHUB_APP_PRIVATE_KEY_PT3" },
		{ "binding": "GITHUB_PERSONAL_ACCESS_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "GH_TOKEN" },
		{ "binding": "CLOUDFLARE_WRANGLER_API_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN" },
		{ "binding": "OPENAI_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "OPENAI_API_KEY" },
		{ "binding": "CLOUDFLARE_ACCOUNT_ID", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_ACCOUNT_ID" },
		{ "binding": "CLOUDFLARE_SECRETS_STORE_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_SECRETS_STORE_TOKEN" },
		{ "binding": "CLOUDFLARE_WORKER_ADMIN_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_WORKER_ADMIN_TOKEN" },
		{ "binding": "CLOUDFLARE_AI_SEARCH_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_AI_SEARCH_TOKEN" },
		{ "binding": "CLOUDFLARE_OBSERVABILITY_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_OBSERVABILITY_TOKEN" },
		{ "binding": "WORKER_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "WORKER_API_KEY" },
		{ "binding": "AGENTIC_WORKER_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "AGENTIC_WORKER_API_KEY" },
		{ "binding": "AI_GATEWAY_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN" },
		{ "binding": "CF_BROWSER_RENDER_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_BROWSER_RENDER_TOKEN" },
		{ "binding": "CLOUDFLARE_IMAGES_STREAM_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "CLOUDFLARE_IMAGES_STREAM_TOKEN" },
		{ "binding": "STITCH_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "STITCH_API_KEY" },
		{ "binding": "JULES_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "JULES_API_KEY" },
		{ "binding": "GEMINI_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "GOOGLE_API_KEY" },
		{ "binding": "ANTHROPIC_API_KEY", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "ANTHROPIC_API_KEY" },
		{ "binding": "DISCORD_TOKEN", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "DISCORD_TOKEN" },
		{ "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1" },
		{ "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2", "store_id": "8c42fa70938644e0a8a109744467375f", "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2" }
	],
	"durable_objects": {
		"bindings": [
			// ── Core Agents (10) ────────────────────────────────────────
			{ "name": "ORCHESTRATOR_AGENT", "class_name": "OrchestratorAgent" },
			{ "name": "ENGINEER_AGENT", "class_name": "EngineerAgent" },
			{ "name": "GUARDRAIL_AGENT", "class_name": "GuardrailAgent" },
			{ "name": "RESEARCH_AGENT", "class_name": "ResearchAgent" },
			{ "name": "GITHUB_AGENT", "class_name": "GithubAgent" },
			{ "name": "CLOUDFLARE_AGENT", "class_name": "CloudflareAgent" },
			{ "name": "DESIGN_AGENT", "class_name": "DesignAgent" },
			{ "name": "LEARNING_AGENT", "class_name": "LearningAgent" },
			{ "name": "WORKSHOP_AGENT", "class_name": "WorkshopAgent" },
			{ "name": "COLLABORATION_AGENT", "class_name": "CollaborationAgent" },
			// ── Infrastructure DOs ────────────────────────────────────
			{ "name": "SANDBOX", "class_name": "Sandbox" },
			{ "name": "JULES_WEBHOOK_BROADCASTER", "class_name": "JulesWebhookBroadcaster" },
			{ "name": "PLANNING_MONITOR", "class_name": "PlanningMonitor" },
			{ "name": "REVERSE_ENGINEERING_MONITOR", "class_name": "ReverseEngineeringMonitor" },
			{ "name": "AGENT_SESSION_DO", "class_name": "AgentSessionDO" },
			{ "name": "ROOM_DO", "class_name": "RoomDO" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				// Core Orchestrator for coordinating sub-agents and decomposing complex tasks
				"OrchestratorAgent",
				// Full-stack engineering agent that writes code and executes plans
				"EngineerAgent",
				// System safeguard agent that ensures alignment with architectural rules
				"GuardrailAgent",
				// Deep research agent for crawling docs, web data, and repo analysis
				"ResearchAgent",
				// Agent specialized in Github API operations (PRs, issues, commits)
				"GithubAgent",
				// Agent specialized in Cloudflare infrastructure and deployment
				"CloudflareAgent",
				// UX/UI designer agent integrating with Stitch to produce frontend code
				"DesignAgent",
				// Hit-in-the-loop observer agent that captures knowledge and trains heuristics
				"LearningAgent",
				// Specialized workflow agent for hosting interactive user workshops
				"WorkshopAgent",
				// Central collaboration room serving as the main bus for agent-user messaging
				"CollaborationAgent",
				// Secure compute environment binding for executing untrusted workloads
				"Sandbox",
				// Fan-out hub for broadcasting fast Jules orchestration state events
				"JulesWebhookBroadcaster",
				// Background tracker for long-running planning and implementation tasks
				"PlanningMonitor",
				// Background tracker for reverse engineering workloads
				"ReverseEngineeringMonitor",
				// WebSocket session handler for real-time agent-to-client connections
				"AgentSessionDO",
				// Low-level generic room entity for robust multiplayer WebSocket bridging
				"RoomDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				// V8-13: Ephemeral subagent for parallel web queries (facet of ResearchAgent)
				"WebQueryWorker"
			]
		}
	],

	"workflows": [
		{ "name": "GithubSearch",			"binding": "GITHUB_SEARCH_WORKFLOW",		"class_name": "GithubSearchWorkflow" },
		{ "name": "DeepResearch",			"binding": "DEEP_RESEARCH_WORKFLOW",		"class_name": "DeepResearchWorkflow" },
		{ "name": "ResearchOrchestrator",	"binding": "RESEARCH_ORCHESTRATOR",			"class_name": "ResearchOrchestrator" },
		{ "name": "LearningWorkflow", 		"binding": "LEARNING_WORKFLOW",				"class_name": "LearningWorkflow" },
		{ "name": "TopicResearch", 			"binding": "TOPIC_RESEARCH_WORKFLOW",		"class_name": "TopicResearchWorkflow" },
		{ "name": "DiscordResearch", 		"binding": "DISCORD_RESEARCH_WORKFLOW",		"class_name": "DiscordResearchWorkflow" },
		{ "name": "PlanningOrchestrator", 	"binding": "PLANNING_ORCHESTRATOR",			"class_name": "PlanningOrchestrator" },
		{ "name": "CloudflareChangelog", 	"binding": "CLOUDFLARE_CHANGELOG_WORKFLOW",	"class_name": "CloudflareChangelogWorkflow" },
		{ "name": "StitchLoop", 			"binding": "STITCH_LOOP_WORKFLOW", 			"class_name": "StitchLoopWorkflow" },
		{ "name": "JulesResearch", 			"binding": "JULES_RESEARCH_WORKFLOW", 		"class_name": "JulesResearchWorkflow" },
		{ "name": "ContinuousLearning", 	"binding": "CONTINUOUS_LEARNING_WORKFLOW", 	"class_name": "ContinuousLearningWorkflow" },
		{ "name": "Hitl", 					"binding": "HITL_WORKFLOW", 				"class_name": "HitlWorkflow" }
	],
	"browser": {
		"binding": "BROWSER"
	},
	"worker_loaders": [
		{ "binding": "LOADER" }
	],
	"r2_buckets": [
		{ "binding": "PLAN_ARTIFACTS", "bucket_name": "core-github-api-plan-artifacts" },
		{ "binding": "ARTIFACT_STORE", "bucket_name": "core-planning-artifacts" },
		{ "binding": "SANDBOX_BUCKET", "bucket_name": "core-github-api-sandbox-bucket" }
	],
	"kv_namespaces": [
		{ "binding": "ETAG_KV", "id": "eed6ba4656704616acf168be80ba770a", 	  "remote": true },
		{ "binding": "COMMENTS_KV", "id": "82d47893d39a4b0fb574b1a760e06452", "remote": true },
		{ "binding": "AGENT_CACHE", "id": "9f070471888c435297b4bce51924f2df", "remote": true },
		{ "binding": "KV_CONFIGS", "id": "a2f723e74e3c4fd6a6377ab09bce9829",  "remote": true }
	],
	// wrangler vectorize create core-github-api-vectors --preset @cf/baai/bge-large-en-v1.5
	// wrangler vectorize create core-github-api-research --dimensions=1024 --metric=cosine
	// wrangler vectorize create core-github-api-logs --preset @cf/baai/bge-large-en-v1.5
	// wrangler vectorize create core-github-api-plan-embeddings --dimensions=1024 --metric=cosine
	// wrangler vectorize create core-github-api-plan-rag --dimensions=1024 --metric=cosine
	// wrangler vectorize create core-github-api-file-embeddings --dimensions=1024 --metric=cosine
	"vectorize": [
		{ "binding": "VECTORIZE", "index_name": "core-github-api-vectors", "remote": true },
		{ "binding": "RESEARCH_INDEX", "index_name": "core-github-api-research", "remote": true },
		{ "binding": "VECTORIZE_LOGS", "index_name": "core-github-api-logs", "remote": true },
		{ "binding": "PLAN_EMBEDDINGS", "index_name": "core-github-api-plan-rag", "remote": true },
		{ "binding": "FILE_EMBEDDINGS", "index_name": "core-github-api-file-embeddings", "remote": true },
		{ "binding": "VECTORIZE_INDEX", "index_name": "sentinel-patterns", "remote": true }
	],
	"d1_databases": [
		{ "binding": "DB", "database_name": "core-github-api", "database_id": "4db39958-8554-4da4-b23d-8a4ea8404588", "migrations_dir": "migrations/core", "remote": true },
		{ "binding": "DB_WEBHOOKS", "database_name": "core-github-api-webhooks", "database_id": "df714884-593d-45da-9c7f-9f67903c4fca", "migrations_dir": "migrations/webhooks", "remote": true }
	],
	// Email sending bindings for Email Routing
	// Targeted binding - sends only to the specified destination address
	"send_email": [
		{ "name": "SEND_EMAIL" },
		{ "name": "SEND_EMAIL_NEWSLETTER", "destination_address": "ai@126colby.com" },
		{ "name": "SEND_EMAIL_ALERTS", "destination_address": "ai@126colby.com" }
	],
	// Scheduled triggers for automated tasks
	// Cron format: minute hour day month day-of-week
	"triggers": {
		"crons": [
			// Daily at 9:00 AM UTC - Triggers Research Orchestrator workflow
			// Analyzes trending GitHub repositories and sends email report
			"0 9 * * *",
			// Weekly at 2:00 AM UTC on Mondays - Scrapes AI model pricing
			// Stores pricing snapshots in D1 and alerts if data becomes stale
			"0 2 * * 1",
			// Every 3 hours - Jules Overseer Check
			"0 */3 * * *",
			// Weekly Health Suite at 3:00 AM UTC on Sundays
			"0 3 * * 7",
			// Every 6 hours - App Store AI Summary Backfill
			// Processes unsummarized apps with Worker AI and saves to D1
			"0 */6 * * *",
			// Daily at 6:00 AM UTC - LearningWorkflow cron trigger
			"0 6 * * *"
		]
	},
	"services": [
		{ "name": "core-github-api-edgraph", "binding": "EDGRAPH", "service": "core-github-api-edgraph" }
	],
	"tail_consumers": [
		{ "service": "core-tail" }
	]
}