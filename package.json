{
  "name": "cloudflare-worker-github-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "A Cloudflare Worker that proxies the GitHub API.",
  "main": "backend/src/index.ts",
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "engines": {
    "pnpm": ">=10.28.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@openai/agents"
      ]
    }
  },
  "scripts": {
    "start": "wrangler dev",
    "test": "vitest --run",
    "test:e2e": "uv run tests/e2e/test_runner.py",
    "install:all": "pnpm install",
    "frontend:add": "pnpm --filter frontend add",
    "frontend:dev": "pnpm --filter frontend dev",
    "db:generate": "pnpm run db:generate:all",
    "db:push": "pnpm --filter frontend drizzle-kit push",
    "deploy:only": "env -u CLOUDFLARE_API_TOKEN wrangler deploy",
    "deploy:tail": "rm -f wrangler.txt && pnpm run deploy && wrangler tail --format pretty | tee wrangler.txt",
    "check": "tsc --noEmit",
    "sandbox-check": "node scripts/verify-sandbox-version.mjs",
    "build:frontend": "VITE_PUBLIC_API_URL=https://core-github-api.hacolby.workers.dev pnpm --filter frontend build",
    "deploy": "pnpm run sandbox-check && pnpm run build:frontend && pnpm run db:generate:all && pnpm run migrate:remote:all && pnpm run deploy:only",
    "dry-run": "WRANGLER_LOG_PATH=.wrangler/wrangler.log pnpm exec wrangler deploy --dry-run",
    "db:generate:core": "drizzle-kit generate --config=backend/drizzle.config.core.ts",
    "db:generate:webhooks": "drizzle-kit generate --config=backend/drizzle.config.webhooks.ts",
    "db:generate:all": "pnpm run db:generate:core && pnpm run db:generate:webhooks",
    "migrate:local:all": "pnpm run migrate:local:core && pnpm run migrate:local:webhooks",
    "migrate:remote:all": "pnpm run migrate:remote:core && pnpm run migrate:remote:webhooks",
    "migrate:local:core": "wrangler d1 migrations apply DB --local",
    "migrate:remote:core": "wrangler d1 migrations apply DB --remote",
    "migrate:local:webhooks": "wrangler d1 migrations apply DB_WEBHOOKS --local",
    "migrate:remote:webhooks": "wrangler d1 migrations apply DB_WEBHOOKS --remote",
    "secrets:audit": "node scripts/audit-secrets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@cloudflare/containers": "latest",
    "@cloudflare/puppeteer": "^1.0.6",
    "@cloudflare/sandbox": "0.7.5",
    "@google/adk": "^0.3.0",
    "@google/genai": "^1.42.0",
    "@google/jules-sdk": "^0.0.6",
    "@hono/swagger-ui": "latest",
    "@hono/zod-openapi": "latest",
    "@hono/zod-validator": "^0.7.6",
    "@iarna/toml": "^2.2.5",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@octokit/graphql": "^7.1.1",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^20.1.2",
    "@octokit/webhooks-methods": "^4.1.0",
    "@openai/agents": "0.4.14",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sinclair/typebox": "^0.34.48",
    "@tsndr/cloudflare-worker-jwt": "^3.2.1",
    "agents": "latest",
    "arktype": "^2.1.29",
    "cloudflare": "^5.2.0",
    "drizzle-orm": "0.45.1",
    "drizzle-zod": "^0.8.3",
    "eventsource": "^4.1.0",
    "handlebars": "^4.7.8",
    "hono": "latest",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "libsodium-wrappers": "^0.8.2",
    "mimetext": "^3.0.28",
    "octokit": "^5.0.5",
    "openai": "^6.22.0",
    "smol-toml": "^1.6.0",
    "uuid": "^13.0.0",
    "valibot": "^1.2.0",
    "yaml": "^2.8.2",
    "zod": "latest",
    "zod-to-json-schema": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^9.39.2",
    "@types/mimetext": "^2.0.4",
    "@types/node": "^20.19.33",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "~3.2.4",
    "wrangler": "latest"
  }
}
