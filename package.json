{
  "name": "cloudflare-worker-github-proxy",
  "version": "1.0.0",
  "description": "A Cloudflare Worker that proxies the GitHub API.",
  "main": "src/index.ts",
  "scripts": {
    "start": "wrangler dev",
    "test": "vitest --run",
    "deploy:only": "wrangler deploy",
    "build:frontend": "cd frontend && bun install && bun run build",
    "deploy": "bun run build:frontend && bun run db:generate:all && bun run migrate:remote:all && bun run deploy:only",
    "dry-run": "npx wrangler deploy --dry-run",
    "db:generate:core": "drizzle-kit generate --config=drizzle.config.core.ts",
    "db:generate:webhooks": "drizzle-kit generate --config=drizzle.config.webhooks.ts",
    "db:generate:all": "bun run db:generate:core && bun run db:generate:webhooks",
    "migrate:local:all": "bun run migrate:local:core && bun run migrate:local:webhooks",
    "migrate:remote:all": "bun run migrate:remote:core && bun run migrate:remote:webhooks",
    "migrate:local:core": "wrangler d1 migrations apply DB --local",
    "migrate:remote:core": "wrangler d1 migrations apply DB --remote",
    "migrate:local:webhooks": "wrangler d1 migrations apply DB_WEBHOOKS --local",
    "migrate:remote:webhooks": "wrangler d1 migrations apply DB_WEBHOOKS --remote"
  },
  "dependencies": {
    "@cloudflare/containers": "latest",
    "@cloudflare/sandbox": "latest",
    "@google/genai": "^1.31.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^0.9.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@octokit/graphql": "^7.0.0",
    "@octokit/plugin-retry": "^8.0.2",
    "@octokit/plugin-throttling": "^11.0.2",
    "@octokit/rest": "^20.0.0",
    "@octokit/webhooks-methods": "^4.1.0",
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
    "agents": "^0.2.20",
    "drizzle-orm": "^0.45.0",
    "eventsource": "^4.1.0",
    "handlebars": "^4.7.8",
    "hono": "^4.0.0",
    "json5": "^2.2.3",
    "kysely": "latest",
    "kysely-d1": "latest",
    "octokit": "^5.0.5",
    "uuid": "^13.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.5",
    "@cloudflare/workers-types": "^4.20251205.0",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.6.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.45.0"
  }
}
